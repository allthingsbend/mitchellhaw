---
import Layout from '../../../layouts/Layout.astro';

const title = 'SEO and local search insights for businesses in Sisters, Oregon. | Mitchell Haw';
const description = 'Practical SEO, AI search, Google Maps, tourism marketing, content, and digital visibility insights for businesses in Sisters, Oregon.';
---

<Layout title={title} description={description}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://mitchellhaw.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Insights",
          "item": "https://mitchellhaw.com/insights/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Sisters",
          "item": "https://mitchellhaw.com/insights/sisters/"
        }
      ]
    }
  </script>

  <main>
    <section class="location-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/insights/">Insights</a>
          <span>/</span>
          <span>Sisters</span>
        </nav>

        <p class="eyebrow">Sisters, Oregon Insights</p>

        <h1>SEO and local search insights for businesses in Sisters, Oregon.</h1>

        <p class="hero-text">
          Practical SEO, AI search, Google Maps, tourism marketing, content, and digital visibility insights for businesses in Sisters, Oregon.
        </p>
      </div>
    </section>

    <section class="intro-section">
      <div class="container intro-grid">
        <div>
          <p class="section-label">Local visibility</p>
          <h2>Helping Sisters businesses get found by locals and visitors.</h2>
        </div>

        <div class="intro-copy">
          <p>Sisters has a distinct business environment shaped by local residents, tourism, events, outdoor recreation, hospitality, retail, restaurants, and seasonal demand. That makes local visibility especially important across Google Search, Maps, reviews, AI answers, travel research, and other discovery channels.</p>
          <p>This section is focused on practical digital marketing and search insights for Sisters businesses, with an emphasis on local discovery, tourism-related searches, Google Business Profile visibility, useful content, and the changing role of AI search.</p>
        </div>
      </div>
    </section>

    <section class="topics-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">Topics</p>
          <h2>What this Sisters section will cover.</h2>
        </div>

        <div class="topic-grid">
          <article class="topic-card">
            <h3>Local SEO in Sisters</h3>
            <p>How businesses can strengthen local relevance and become easier to find for nearby customers and visitors.</p>
          </article>
          <article class="topic-card">
            <h3>Tourism Search Visibility</h3>
            <p>Ideas for hotels, restaurants, shops, experiences, and other businesses that depend on travel research and seasonal demand.</p>
          </article>
          <article class="topic-card">
            <h3>Google Maps & Reviews</h3>
            <p>How Business Profile information, reviews, photos, categories, and local signals influence discovery.</p>
          </article>
          <article class="topic-card">
            <h3>AI Search Discovery</h3>
            <p>How businesses can build stronger signals for discovery across ChatGPT, Google AI, Perplexity, and similar tools.</p>
          </article>
          <article class="topic-card">
            <h3>Useful Local Content</h3>
            <p>How original guides, FAQs, service pages, and local expertise can help businesses answer real customer questions.</p>
          </article>
          <article class="topic-card">
            <h3>Seasonal Search Strategy</h3>
            <p>Ways to think about changing search demand around events, summer travel, winter trips, and shoulder seasons.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="future-section">
      <div class="container future-grid">
        <div>
          <p class="section-label light">Growing resource</p>
          <h2>Guides and articles planned for Sisters.</h2>
          <p>
            This hub will grow with practical, original content focused on real search
            questions, local business visibility, AI search, Google Maps, and the changing
            ways people discover businesses.
          </p>
        </div>

        <div class="future-card">
          <span class="future-label">Planned topics</span>
          <ul>
          <li>Local SEO for Sisters, Oregon Businesses</li>
          <li>Digital Marketing for Tourism Businesses in Sisters</li>
          <li>How Small Businesses in Sisters Can Improve Google Visibility</li>
          <li>How to Improve Google Maps Visibility in Sisters</li>
          <li>AI Search Opportunities for Sisters Businesses</li>
          <li>Seasonal Content Ideas for Sisters, Oregon Businesses</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="more-section">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">Explore more</p>
          <h2>More Central Oregon insights.</h2>
        </div>

        <div class="location-links">
          <a class="location-link" href="/insights/bend/">
            Bend insights <span>→</span>
          </a>
          <a class="location-link" href="/insights/redmond/">
            Redmond insights <span>→</span>
          </a>
          <a class="location-link" href="/insights/sunriver/">
            Sunriver insights <span>→</span>
          </a>
          <a class="location-link all" href="/insights/">
            View all insights <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container cta-inner">
        <p class="section-label">Need help getting found?</p>
        <h2>Let’s make your business easier to discover.</h2>
        <p>
          I help businesses improve visibility across Google, AI search, Maps,
          content, local listings, and the broader digital discovery journey.
        </p>

        <div class="cta-buttons">
          <a href="/contact" class="primary-btn">Talk about visibility for your Sisters business</a>
          <a href="/insights/" class="secondary-btn">Back to all insights</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  :root {
    --cream: #f5f1ea;
    --sand: #e7dccb;
    --pine: #245747;
    --pine-dark: #15382f;
    --sage: #d8e2d7;
    --text: #1f2933;
    --muted: #5f6f66;
    --white: #ffffff;
    --border: #d8d0c3;
  }

  .container {
    width: min(1120px, 92%);
    margin: 0 auto;
  }

  .location-hero {
    padding: 70px 0 90px;
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(216, 226, 215, 0.82),
        transparent 32%
      ),
      var(--cream);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 54px;
    color: var(--muted);
    font-size: 14px;
  }

  .breadcrumb a {
    color: var(--pine);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 12px;
    color: var(--pine);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-label.light {
    color: #cbded6;
  }

  .location-hero h1 {
    max-width: 930px;
    margin: 12px 0 24px;
    color: var(--pine-dark);
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .hero-text {
    max-width: 760px;
    margin: 0;
    color: var(--muted);
    font-size: 21px;
    line-height: 1.7;
  }

  .intro-section,
  .topics-section,
  .more-section,
  .cta-section {
    padding: 90px 0;
  }

  .intro-section,
  .more-section {
    background: var(--white);
  }

  .intro-grid,
  .future-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .intro-grid h2,
  .section-heading h2,
  .future-section h2,
  .cta-section h2 {
    margin: 0;
    color: var(--pine-dark);
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .intro-copy {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.75;
  }

  .intro-copy p:first-child {
    margin-top: 0;
  }

  .topics-section {
    background: var(--cream);
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 44px;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .topic-card {
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
  }

  .topic-card h3 {
    margin: 0 0 12px;
    color: var(--pine-dark);
    font-size: 23px;
    line-height: 1.2;
  }

  .topic-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .future-section {
    padding: 95px 0;
    background: var(--pine-dark);
    color: var(--white);
  }

  .future-section h2 {
    color: var(--white);
  }

  .future-section p:not(.section-label) {
    color: #d8e2dd;
    font-size: 18px;
    line-height: 1.75;
  }

  .future-card {
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.07);
  }

  .future-label {
    display: block;
    margin-bottom: 20px;
    color: #cbded6;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .future-card ul {
    margin: 0;
    padding-left: 20px;
  }

  .future-card li {
    margin-bottom: 13px;
    color: #f3f6f4;
    line-height: 1.55;
  }

  .future-card li:last-child {
    margin-bottom: 0;
  }

  .location-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .location-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--cream);
    color: var(--pine-dark);
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .location-link:hover {
    transform: translateY(-2px);
    border-color: var(--pine);
  }

  .location-link.all {
    background: var(--sage);
  }

  .cta-section {
    background: var(--sage);
  }

  .cta-inner {
    max-width: 780px;
    text-align: center;
  }

  .cta-section p:not(.section-label) {
    max-width: 640px;
    margin: 20px auto 28px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .primary-btn,
  .secondary-btn {
    display: inline-block;
    padding: 14px 22px;
    border-radius: 9px;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-btn {
    background: var(--pine);
    color: var(--white);
  }

  .primary-btn:hover {
    background: var(--pine-dark);
  }

  .secondary-btn {
    border: 1px solid var(--pine);
    color: var(--pine-dark);
    background: transparent;
  }

  .secondary-btn:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  @media (max-width: 800px) {
    .location-hero {
      padding: 45px 0 65px;
    }

    .breadcrumb {
      margin-bottom: 38px;
    }

    .intro-section,
    .topics-section,
    .more-section,
    .cta-section,
    .future-section {
      padding: 65px 0;
    }

    .intro-grid,
    .future-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .topic-grid,
    .location-links {
      grid-template-columns: 1fr;
    }
  }
</style>
