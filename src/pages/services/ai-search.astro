---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <title>AI Search Consulting | Mitchell Haw</title>
    <meta name="description" content="AI search strategy for ChatGPT, Perplexity, Gemini, Google AI Overviews, and emerging answer engines." />
  </head>

  <body>
    <Header />

    <main>
      <section class="page-hero">
        <div class="container narrow">
          <p class="section-label">AI Search</p>
          <h1>Help your brand show up in AI-powered search.</h1>
          <p>
            Search is changing. I help businesses prepare for visibility across ChatGPT,
            Perplexity, Gemini, Google AI Overviews, and other answer engines.
          </p>
        </div>
      </section>

      <section class="services">
        <div class="container">
          <div class="service-grid three">
            <div class="card">
              <h3>AI Visibility Strategy</h3>
              <p>Identify where your brand appears, where competitors are mentioned, and what content gaps need to be filled.</p>
            </div>

            <div class="card">
              <h3>Entity & Brand Clarity</h3>
              <p>Improve how AI systems understand who you are, what you offer, where you operate, and why you are trustworthy.</p>
            </div>

            <div class="card">
              <h3>Answer-Friendly Content</h3>
              <p>Create clear, useful content that answers real questions and supports both traditional SEO and AI discovery.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="intro">
        <div class="container narrow">
          <h2>AI search builds on strong SEO.</h2>
          <p>
            The best AI search strategy starts with a clean website, helpful content,
            consistent brand signals, structured information, and strong web presence.
          </p>
          <a href="/contact" class="primary-btn">Reach Out</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
