---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const title = 'Redmond Oregon SEO Consultant | Local SEO & SEO Services';
const description =
  'SEO consulting for Redmond, Oregon businesses. Improve local rankings, Google Maps visibility, website content, technical SEO, AI search visibility, and qualified leads.';

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const faqs = [
  {
    question: 'What does SEO for a Redmond business include?',
    answer:
      'It depends on the business, but a Redmond SEO strategy may include Google Business Profile optimization, local keyword research, service and location pages, technical SEO, content improvements, internal linking, local search visibility, analytics, and conversion tracking.'
  },
  {
    question: 'Do I need separate Redmond and Bend SEO pages?',
    answer:
      'Sometimes. If your business genuinely serves both markets and people search for your services in both cities, separate pages can make sense. The goal is not to duplicate the same page and swap city names. Each location page should have a clear purpose, useful local information, and content that reflects how you actually serve that market.'
  },
  {
    question: 'Can my business show up in Redmond if I am based somewhere else in Central Oregon?',
    answer:
      'Potentially. Your website can target areas you genuinely serve, while your Google Business Profile should accurately represent your real location or service area. The right strategy depends on your business model, competition, service area, and where customers are searching.'
  },
  {
    question: 'What if my business serves customers at their location instead of a storefront?',
    answer:
      'Service-area businesses can build strong local visibility without pretending to have a storefront in every city they serve. Your Google Business Profile, website service areas, location content, reviews, and overall local signals should accurately reflect where you actually do business.'
  },
  {
    question: 'How long does SEO take?',
    answer:
      'There is no single timeline. Technical fixes and local profile improvements can sometimes make an impact relatively quickly, while competitive organic rankings and broader content growth usually take longer. I focus on identifying the highest-impact opportunities first and measuring progress over time.'
  },
  {
    question: 'Do you help with AI search visibility too?',
    answer:
      'Yes. Modern SEO includes making your business and website easier for both traditional search engines and AI-driven search experiences to understand. Clear site structure, useful content, strong entity signals, local relevance, and authoritative information can support visibility across multiple search experiences.'
  }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Redmond Oregon SEO Consulting',
  serviceType: 'Search Engine Optimization Consulting',
  description,
  areaServed: {
    '@type': 'City',
    name: 'Redmond',
    containedInPlace: {
      '@type': 'State',
      name: 'Oregon'
    }
  },
  provider: {
    '@type': 'Person',
    name: 'Mitchell Haw',
    url: 'https://mitchellhaw.com/'
  },
  url: canonical.href
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<html lang="en">
  <head>
    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  </head>

  <body>
    <Header />

    <main>

      <!-- HERO -->
      <section class="page-hero">
        <div class="container narrow">
          <p class="section-label">Redmond Oregon SEO Services</p>

          <h1>
            SEO for Redmond businesses that want to be easier to find — and easier to choose.
          </h1>

          <p>
            I help businesses in Redmond, Oregon improve their visibility in Google,
            Maps, local search, and modern AI-driven search experiences. The goal is
            simple: help more of the right people discover your business when they
            are actively looking for what you offer.
          </p>

          <p>
            <a class="button" href="/contact/">
              Talk About Your Redmond SEO
            </a>
          </p>
        </div>
      </section>


      <!-- CORE SERVICES -->
      <section class="services" id="redmond-seo-services">
        <div class="container">

          <div class="container narrow">
            <p class="section-label">How I Can Help</p>

            <h2>
              Practical SEO services for Redmond businesses
            </h2>

            <p>
              SEO is rarely one thing. Strong local visibility usually comes from
              improving several parts of your search presence together — your website,
              Google Business Profile, content, technical foundation, local relevance,
              and measurement.
            </p>
          </div>

          <div class="service-grid three">

            <div class="service-card">
              <h3>Local SEO & Google Maps</h3>
              <p>
                Improve how your business appears for Redmond searches through
                better Google Business Profile optimization, local signals,
                service information, reviews, and location relevance.
              </p>
            </div>

            <div class="service-card">
              <h3>Technical SEO</h3>
              <p>
                Find crawling, indexing, canonical, metadata, internal linking,
                site architecture, speed, and other technical issues that may
                be limiting organic visibility.
              </p>
            </div>

            <div class="service-card">
              <h3>Service & Location Pages</h3>
              <p>
                Build useful pages around the services and geographic markets
                your business actually serves instead of creating thin,
                repetitive city pages.
              </p>
            </div>

            <div class="service-card">
              <h3>Content Strategy</h3>
              <p>
                Identify the questions, services, problems, and topics your
                potential customers are searching for and turn them into useful
                content with a clear business purpose.
              </p>
            </div>

            <div class="service-card">
              <h3>AI Search Visibility</h3>
              <p>
                Make your website easier for search engines and AI-powered
                discovery tools to understand through clear information,
                strong structure, useful content, and better brand signals.
              </p>
            </div>

            <div class="service-card">
              <h3>Analytics & SEO Reporting</h3>
              <p>
                Connect rankings and traffic to the outcomes that matter:
                calls, form submissions, bookings, purchases, leads, and
                revenue whenever that data is available.
              </p>
            </div>

          </div>
        </div>
      </section>


      <!-- REDMOND-SPECIFIC STRATEGY -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Local Strategy</p>

          <h2>
            Redmond SEO should not just be Bend SEO with a different city name.
          </h2>

          <p>
            Redmond is its own market, but it is also closely connected to the
            rest of Central Oregon. Depending on your business, your customers
            may come primarily from Redmond itself, from surrounding communities,
            from across the Bend-Redmond area, or from people visiting Central Oregon.
          </p>

          <p>
            That changes how I approach keyword targeting and site structure.
            Instead of automatically creating a page for every nearby city,
            I look at where you actually do business, what people are searching
            for, how competitive those searches are, and which pages deserve
            to exist on your website.
          </p>

          <p>
            For example, a business serving customers near Downtown Redmond may
            need a very different local strategy from a contractor traveling
            throughout Central Oregon, a professional service company serving
            Redmond and Bend, or a hospitality business reaching people coming
            through Redmond Municipal Airport.
          </p>

        </div>
      </section>


      <!-- SEARCH MARKET -->
      <section class="services">
        <div class="container">

          <div class="container narrow">
            <h2>
              Understanding the Redmond search market
            </h2>

            <p>
              A good SEO strategy starts by separating different kinds of
              search intent instead of treating every local keyword the same.
            </p>
          </div>

          <div class="service-grid three">

            <div class="service-card">
              <h3>Redmond-Specific Searches</h3>
              <p>
                Searches where the customer specifically wants a business,
                service, product, or professional in Redmond.
              </p>

              <p>
                Examples might include searches such as
                “Redmond Oregon plumber,” “dentist in Redmond,”
                or “Redmond OR landscaping.”
              </p>
            </div>

            <div class="service-card">
              <h3>Central Oregon Searches</h3>
              <p>
                Some businesses compete regionally instead of within a single
                city. In those cases, Central Oregon terms may deserve their
                own pages or may fit naturally into broader service content.
              </p>
            </div>

            <div class="service-card">
              <h3>Nearby Market Searches</h3>
              <p>
                If you genuinely serve communities such as Bend, Terrebonne,
                Prineville, Sisters, Powell Butte, or other nearby areas,
                we can determine where separate location targeting makes sense
                and where it does not.
              </p>
            </div>

          </div>
        </div>
      </section>


      <!-- GBP / LOCAL SEO -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Local Search</p>

          <h2>
            Showing up in Redmond Google Maps and local results
          </h2>

          <p>
            For many local businesses, the traditional organic results are
            only part of the opportunity. Google Business Profile and Maps
            visibility can be just as important — especially for searches
            with strong local intent.
          </p>

          <p>
            Local SEO work may include:
          </p>

          <ul>
            <li>Google Business Profile category and service optimization</li>
            <li>Accurate business information and service areas</li>
            <li>Review strategy and review response guidance</li>
            <li>Business descriptions, photos, services, and profile completeness</li>
            <li>Local website content supporting your primary services</li>
            <li>Consistent business information across important listings</li>
            <li>Location-relevant internal linking</li>
            <li>Tracking calls, forms, bookings, and other conversions</li>
          </ul>

          <p>
            If you are a service-area business rather than a storefront,
            the strategy should reflect that. You do not need to pretend to
            have an office in every city you serve. A better approach is to
            accurately represent your real business while building strong,
            useful website content around the markets where you actually work.
          </p>

        </div>
      </section>


      <!-- BUSINESS TYPES -->
      <section class="services">
        <div class="container">

          <div class="container narrow">
            <p class="section-label">Different Businesses, Different Strategies</p>

            <h2>
              Local SEO depends on how your Redmond business actually gets customers
            </h2>
          </div>

          <div class="service-grid three">

            <div class="service-card">
              <h3>Home & Service Businesses</h3>
              <p>
                Contractors, plumbers, electricians, landscapers, cleaners,
                roofers, HVAC companies, and other service businesses often
                need strong service pages, local visibility, reviews, and a
                clear service-area strategy.
              </p>
            </div>

            <div class="service-card">
              <h3>Local Storefronts & Professionals</h3>
              <p>
                Restaurants, retailers, healthcare providers, real estate
                professionals, attorneys, financial services, and other local
                businesses often depend heavily on Maps visibility, reputation,
                local landing pages, and high-intent searches.
              </p>
            </div>

            <div class="service-card">
              <h3>Regional & B2B Companies</h3>
              <p>
                Manufacturing, industrial, professional, and B2B companies may
                need less emphasis on “near me” searches and more focus on
                services, expertise, industries, case studies, and broader
                Central Oregon or national search demand.
              </p>
            </div>

          </div>
        </div>
      </section>


      <!-- LOCATION PAGE STRATEGY -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Location Pages</p>

          <h2>
            Serving Redmond, Bend, and Central Oregon without creating duplicate city pages
          </h2>

          <p>
            One of the most common local SEO mistakes is creating nearly identical
            pages for Redmond, Bend, Sisters, Prineville, and every other nearby
            community — then changing little more than the city name.
          </p>

          <p>
            I would rather create fewer pages that are genuinely useful.
            A location page should have a reason to exist.
          </p>

          <p>
            That can include:
          </p>

          <ul>
            <li>Services specifically available in that market</li>
            <li>Real information about how you serve the area</li>
            <li>Relevant customer questions</li>
            <li>Local examples or projects when available</li>
            <li>Testimonials or proof connected to that market</li>
            <li>Useful service-area information</li>
            <li>Unique internal links and calls to action</li>
          </ul>

          <p>
            This creates a cleaner website for customers and a much stronger
            foundation for search than dozens of thin location pages.
          </p>

        </div>
      </section>


      <!-- REDMOND CONTEXT -->
      <section class="services">
        <div class="container">

          <div class="container narrow">
            <p class="section-label">Why Local Context Matters</p>

            <h2>
              Redmond businesses can serve several very different audiences
            </h2>

            <p>
              Redmond sits in a useful position within Central Oregon. That can
              create different search opportunities depending on the business.
            </p>
          </div>

          <div class="service-grid three">

            <div class="service-card">
              <h3>Redmond Residents</h3>
              <p>
                Businesses primarily serving local residents should usually
                prioritize high-intent Redmond searches, Maps visibility,
                reputation, and strong core service pages.
              </p>
            </div>

            <div class="service-card">
              <h3>Central Oregon Customers</h3>
              <p>
                Businesses with a wider service area may need to balance
                Redmond visibility with Bend, Terrebonne, Prineville, Sisters,
                Powell Butte, and broader Central Oregon demand.
              </p>
            </div>

            <div class="service-card">
              <h3>Visitors & Travelers</h3>
              <p>
                Hospitality, recreation, transportation, restaurants, lodging,
                and other visitor-focused businesses may also benefit from
                searches connected to RDM, Smith Rock, Eagle Crest, and
                Central Oregon travel.
              </p>
            </div>

          </div>
        </div>
      </section>


      <!-- PROCESS -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">SEO Process</p>

          <h2>
            How I approach SEO for a Redmond business
          </h2>

          <h3>1. Understand the business</h3>
          <p>
            Before worrying about rankings, I want to understand what you sell,
            which services matter most, where your customers come from, and
            what a valuable lead or conversion actually looks like.
          </p>

          <h3>2. Understand what people are searching for</h3>
          <p>
            I map your services to actual search behavior and separate
            Redmond-specific opportunities from broader Central Oregon,
            informational, and non-local searches.
          </p>

          <h3>3. Audit the website and local presence</h3>
          <p>
            I look at page structure, content, internal links, metadata,
            crawlability, indexing, Google Business Profile, local relevance,
            competitors, and measurement.
          </p>

          <h3>4. Prioritize what can make the biggest difference</h3>
          <p>
            Not every SEO recommendation deserves to be done immediately.
            I focus on the improvements most likely to increase qualified
            visibility and business results.
          </p>

          <h3>5. Measure what happens</h3>
          <p>
            Rankings are useful, but they are not the end goal. Whenever
            possible, SEO reporting should connect visibility to traffic,
            calls, leads, bookings, purchases, or revenue.
          </p>

        </div>
      </section>


      <!-- SEARCH EVERYWHERE -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Modern Search</p>

          <h2>
            SEO now means being visible wherever your customers search
          </h2>

          <p>
            Google is still a major part of SEO, but discovery is increasingly
            spread across Maps, traditional organic results, video platforms,
            social platforms, and AI-driven search experiences.
          </p>

          <p>
            The fundamentals still matter: make your business easy to
            understand, create genuinely useful information, clearly explain
            what you offer and where you offer it, build authority, and make
            the website easy for both people and search engines to navigate.
          </p>

          <p>
            I approach SEO with that bigger picture in mind rather than chasing
            a single ranking or one search platform.
          </p>

        </div>
      </section>


      <!-- WHY ME -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Central Oregon SEO Consulting</p>

          <h2>
            Local knowledge with a practical SEO approach
          </h2>

          <p>
            I am based in Bend and provide SEO consulting for businesses
            throughout Central Oregon, including Redmond.
          </p>

          <p>
            That local perspective helps when deciding how Redmond fits into
            a broader search strategy. A business may need to focus almost
            entirely on Redmond, compete across the Bend-Redmond market, or
            target several Central Oregon communities depending on how
            customers actually find and hire them.
          </p>

          <p>
            My approach is straightforward: understand the opportunity,
            identify what is holding the site back, prioritize the work,
            and make SEO easier to understand.
          </p>

        </div>
      </section>


      <!-- FAQ -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Frequently Asked Questions</p>

          <h2>
            Redmond Oregon SEO FAQs
          </h2>

          {faqs.map((faq) => (
            <div>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}

        </div>
      </section>


      <!-- CTA -->
      <section class="content-section">
        <div class="container narrow">

          <p class="section-label">Redmond SEO Consultant</p>

          <h2>
            Want to improve your visibility in Redmond?
          </h2>

          <p>
            Whether you need a full SEO strategy or simply want someone to
            look at your website and tell you what to focus on next, I can
            help identify the best opportunities.
          </p>

          <p>
            <a class="button" href="/contact/">
              Contact Me About Redmond SEO
            </a>
          </p>

        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>
