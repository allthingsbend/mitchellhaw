---
import Layout from '../layouts/Layout.astro';

const groups = [
  {
    label: 'Main',
    description: 'Start here and learn more about Mitchell Haw.',
    pages: [
      { title: 'Home', url: '/', description: 'SEO, local search, AI search, and website strategy for Bend and Central Oregon businesses.' },
      { title: 'About Mitchell', url: '/about/', description: 'Background, experience, and approach to search strategy.' },
      { title: 'Contact', url: '/contact/', description: 'Talk about your business, website, or search visibility goals.' },
      { title: 'Insights', url: '/insights/', description: 'SEO, AI search, local visibility, content, analytics, and digital marketing insights.' }
    ]
  },
  {
    label: 'Services',
    description: 'Ways I help businesses improve visibility and grow through search.',
    pages: [
      { title: 'SEO Strategy', url: '/services/seo/', description: 'Technical SEO, website structure, content strategy, migrations, and organic growth.' },
      { title: 'Local SEO in Bend', url: '/services/seo-bend-oregon/', description: 'Google Maps, local search, website SEO, reviews, and visibility for Bend businesses.' },
      { title: 'AI Search Visibility', url: '/services/ai-search/', description: 'Understand and improve how your business appears in ChatGPT, Google AI, Gemini, Perplexity, and other AI search tools.' },
      { title: 'Video Marketing', url: '/services/video-marketing/', description: 'YouTube, short-form video, search-friendly video content, and video discovery strategy.' }
    ]
  },
  {
    label: 'Central Oregon SEO',
    description: 'Local search pages for businesses serving Central Oregon communities.',
    pages: [
      { title: 'Bend SEO', url: '/services/seo-bend-oregon/', description: 'SEO and local visibility for businesses in Bend, Oregon.' },
      { title: 'Redmond SEO', url: '/services/seo-redmond-oregon/', description: 'SEO and local visibility for businesses in Redmond, Oregon.' },
      { title: 'Sisters SEO', url: '/services/seo-sisters-oregon/', description: 'SEO and local visibility for businesses in Sisters, Oregon.' },
      { title: 'Sunriver SEO', url: '/services/seo-sunriver-oregon/', description: 'SEO and local visibility for businesses serving Sunriver and nearby areas.' }
    ]
  },
  {
    label: 'Local Insights',
    description: 'Search and digital marketing ideas organized by Central Oregon market.',
    pages: [
      { title: 'Bend Insights', url: '/insights/bend/', description: 'SEO, AI search, local marketing, and visibility ideas for Bend businesses.' },
      { title: 'Redmond Insights', url: '/insights/redmond/', description: 'Search visibility and digital marketing ideas for Redmond businesses.' },
      { title: 'Sisters Insights', url: '/insights/sisters/', description: 'SEO and local visibility ideas for businesses in Sisters.' },
      { title: 'Sunriver Insights', url: '/insights/sunriver/', description: 'Search and marketing ideas for businesses serving Sunriver and visitors.' }
    ]
  }
];
---

<Layout
  title="HTML Sitemap | Mitchell Haw"
  description="Browse all public pages on MitchellHaw.com, including SEO services, Central Oregon local SEO pages, insights, about, and contact."
>
  <main class="site-map">
    <section class="map-hero">
      <div class="container map-hero-grid">
        <div>
          <p class="map-kicker">MITCHELLHAW.COM</p>
          <h1>Site map</h1>
        </div>
        <p>
          Browse the public pages on the site, organized by services, Central Oregon locations, and local search insights.
        </p>
      </div>
    </section>

    <section class="map-content">
      <div class="container">
        {groups.map((group) => (
          <section class="map-group">
            <div class="map-group-head">
              <div>
                <p class="map-kicker">{group.label}</p>
                <h2>{group.label}</h2>
              </div>
              <p>{group.description}</p>
            </div>

            <div class="map-grid">
              {group.pages.map((page) => (
                <a class="map-card" href={page.url}>
                  <div>
                    <h3>{page.title}</h3>
                    <p>{page.description}</p>
                  </div>
                  <span>View page →</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  .site-map {
    --cream: #f6f4ee;
    --paper: #fffdf9;
    --ink: #1c2923;
    --copy: #5b6861;
    --forest: #356b57;
    --river: #2f6f8f;
    --sage: #e6eee8;
    --line: #d8ddd7;
    background: var(--cream);
    color: var(--ink);
  }

  .site-map .container { width: min(1180px, 92%); margin: 0 auto; }
  .map-kicker { margin: 0 0 12px; color: var(--forest); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }

  .map-hero { padding: 80px 0 72px; border-bottom: 1px solid var(--line); background: linear-gradient(135deg, var(--cream), #edf2ed); }
  .map-hero-grid { display: grid; grid-template-columns: 1fr .85fr; gap: 70px; align-items: end; }
  .map-hero h1 { margin: 0; color: var(--ink); font-size: clamp(3.8rem, 8vw, 7rem); line-height: .92; letter-spacing: -.06em; }
  .map-hero-grid > p { max-width: 560px; margin: 0 0 8px; color: var(--copy); font-size: 1.08rem; }

  .map-content { padding: 84px 0 100px; }
  .map-group + .map-group { margin-top: 78px; padding-top: 72px; border-top: 1px solid var(--line); }
  .map-group-head { display: grid; grid-template-columns: 1fr .85fr; gap: 70px; align-items: end; margin-bottom: 30px; }
  .map-group-head h2 { margin: 0; color: var(--ink); font-size: clamp(2.2rem, 4vw, 3.6rem); line-height: 1; letter-spacing: -.045em; }
  .map-group-head > p { max-width: 540px; margin: 0; color: var(--copy); }

  .map-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .map-card { display: flex; min-height: 190px; flex-direction: column; justify-content: space-between; padding: 26px; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); color: var(--ink); text-decoration: none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .map-card:hover { transform: translateY(-2px); border-color: #bcc9c0; box-shadow: 0 14px 34px rgba(28,41,35,.06); }
  .map-card h3 { margin: 0 0 9px; color: var(--ink); font-size: 1.25rem; letter-spacing: -.025em; }
  .map-card p { margin: 0; color: var(--copy); font-size: .92rem; }
  .map-card span { margin-top: 24px; color: var(--river); font-size: .82rem; font-weight: 800; }

  @media (max-width: 760px) {
    .map-hero { padding: 62px 0 56px; }
    .map-hero-grid, .map-group-head { grid-template-columns: 1fr; gap: 24px; }
    .map-content { padding: 64px 0 80px; }
    .map-group + .map-group { margin-top: 58px; padding-top: 54px; }
    .map-grid { grid-template-columns: 1fr; }
  }
</style>