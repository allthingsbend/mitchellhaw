---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Mitchell Haw | SEO & AI Search Help"
  description="Reach out to Mitchell Haw for SEO, AI search, local SEO, content strategy, and video marketing help."
>
  <main>
    <section class="page-hero">
      <div class="container narrow">
        <p class="section-label">Contact</p>
        <h1>Reach out about SEO, AI search, or digital visibility help.</h1>
        <p>Send me a quick note about what you are working on and where you need help.</p>
        <a
          href="https://docs.google.com/forms/d/e/1FAIpQLSc8-OP6SW3D1AjAc0HUYMB5bq5DySUd0B76N4_lUFI_twafJw/viewform?usp=publish-editor"
          class="primary-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          Contact Me
        </a>
      </div>
    </section>

    <section class="intro">
      <div class="container narrow">
        <h2>Good fits</h2>
        <p>
          SEO strategy, AI search visibility, local SEO, content planning, site architecture,
          technical SEO audits, website migrations, video marketing strategy, and organic growth planning.
        </p>
      </div>
    </section>
  </main>
</Layout>
