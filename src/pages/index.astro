    background: white;
    padding: 28px;
    border-radius: 14px;
    border: 1px solid var(--border);
  }

  .card h3 {
    margin-top: 0;
    margin-bottom: 12px;
  }

  .about,
  .cta {
    background: white;
  }

  .cta {
    text-align: center;
