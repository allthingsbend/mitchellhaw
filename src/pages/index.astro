  .primary-btn:hover {
    opacity: 0.92;
  }

  .secondary-btn {
    border: 2px solid var(--accent);
    color: var(--accent);
  }

  section {
    padding: 80px 0;
  }

  h2 {
    font-size: 2.2rem;
    margin-bottom: 32px;
  }

  .service-grid {
    display: grid;
