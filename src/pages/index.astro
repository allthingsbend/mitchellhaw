---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mitchell Haw | SEO & AI Search Consultant in Bend, Oregon"
  description="Mitchell Haw helps businesses improve SEO, AI search visibility, local search, content strategy, and organic growth."
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://mitchellhaw.com/#person",
          "name": "Mitchell Haw",
          "url": "https://mitchellhaw.com/",
          "jobTitle": "Digital Strategist & SEO / AI Search Lead",
          "image": "https://mitchellhaw.com/images/mitchell-haw.jpg",
          "sameAs": ["https://www.linkedin.com/in/mitchellhaw"],
          "description": "Digital Strategist specializing in SEO and AI Search optimization."
        },
        {
          "@type": "WebSite",
          "@id": "https://mitchellhaw.com/#website",
          "url": "https://mitchellhaw.com/",
          "name": "Mitchell Haw",
          "publisher": {
            "@id": "https://mitchellhaw.com/#person"
          }
        }
      ]
    }
  </script>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">SEO & AI Search Consultant in Bend, Oregon</p>
          <h1>Helping businesses get found wherever people search.</h1>
          <p class="hero-text">
            I help brands improve visibility across Google, AI search, local maps,
            YouTube, content platforms, and the search experiences shaping how people discover businesses today.
          </p>

          <div class="hero-buttons">
            <a href="/services/seo" class="primary-btn">Explore SEO Services</a>
            <a href="/services/ai-search" class="secondary-btn">AI Search Strategy</a>
          </div>
        </div>

        <div class="visibility-card">
          <p class="card-label">Search Visibility System</p>
          <div class="orbit">
            <span>Google</span>
            <span>AI Search</span>
            <span>Maps</span>
            <span>YouTube</span>
            <span>Content</span>
            <span>Reviews</span>
          </div>
          <p>
            Modern search is not one channel anymore. I help businesses build the foundation to show up across the full discovery journey.
          </p>
        </div>
      </div>
    </section>

    <section class="intro">
      <div class="container intro-grid">
        <div>
          <p class="section-label">Modern search strategy</p>
          <h2>SEO is no longer just rankings and keywords.</h2>
        </div>
        <div>
          <p>
            People now discover businesses through Google, maps, AI answers, YouTube,
            social platforms, local listings, reviews, and content recommendations.
          </p>
          <p>
            I help businesses connect those pieces into one practical search strategy.
          </p>
        </div>
      </div>
    </section>

    <section class="services">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">What I help with</p>
          <h2>Search visibility built for how people find businesses now.</h2>
        </div>

        <div class="service-grid">
          <div class="card">
            <span class="card-number">01</span>
            <h3>SEO Strategy</h3>
            <p>Technical SEO, content planning, keyword research, metadata, internal linking, and site architecture.</p>
          </div>

          <div class="card">
            <span class="card-number">02</span>
            <h3>AI Search Visibility</h3>
            <p>Improve how your business appears across ChatGPT, Perplexity, Gemini, AI Overviews, and answer engines.</p>
          </div>

          <div class="card">
            <span class="card-number">03</span>
            <h3>Local SEO</h3>
            <p>Google Business Profile optimization, local landing pages, maps visibility, reviews, and citations.</p>
          </div>

          <div class="card">
            <span class="card-number">04</span>
            <h3>Video & Content Discovery</h3>
            <p>YouTube, short-form video, content hubs, and search-friendly publishing systems that support organic growth.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="search-everywhere">
      <div class="container search-grid">
        <div>
          <p class="section-label light">Search everywhere</p>
          <h2>Your customers are searching in more places than ever.</h2>
          <p>
            I help businesses show up in the places that matter most, from traditional organic results to AI-generated answers and local discovery.
          </p>
        </div>

        <div class="channel-grid">
          <div>Google Search</div>
          <div>Google Maps</div>
          <div>AI Answers</div>
          <div>YouTube</div>
          <div>Local Listings</div>
          <div>Content Hubs</div>
        </div>
      </div>
    </section>

    <section class="about">
      <div class="container about-grid">
        <div>
          <p class="section-label">About</p>
          <h2>Practical SEO and AI search support from Bend, Oregon.</h2>
        </div>

        <div>
          <p>
            I’m Mitchell Haw, a digital strategist focused on SEO, AI search,
            local visibility, content strategy, and organic growth.
          </p>

          <p>
            I work with businesses that want clear strategy, useful content,
            stronger technical foundations, and better visibility across the full search journey.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container narrow">
        <p class="section-label">Ready to improve visibility?</p>
        <h2>Let’s make your business easier to find.</h2>
        <p>
          Whether you need SEO strategy, AI search support, local SEO help,
          or a clearer content roadmap, I can help you figure out what to focus on next.
        </p>
        <a href="/contact" class="primary-btn">Contact Me</a>
      </div>
    </section>
  </main>
</Layout>
