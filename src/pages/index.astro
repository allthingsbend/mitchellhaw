---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mitchell Haw | SEO & AI Search Consultant in Bend, Oregon"
  description="Mitchell Haw helps businesses improve SEO, AI search visibility, local search, content strategy, and organic growth."
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://mitchellhaw.com/#person",
          "name": "Mitchell Haw",
          "url": "https://mitchellhaw.com/",
          "jobTitle": "Digital Strategist & SEO / AI Search Lead",
          "image": "https://mitchellhaw.com/images/mitchell-haw.jpg",
          "sameAs": [
            "https://www.linkedin.com/in/mitchellhaw"
          ],
          "description": "Digital Strategist specializing in SEO and AI Search optimization."
        },
        {
          "@type": "WebSite",
          "@id": "https://mitchellhaw.com/#website",
          "url": "https://mitchellhaw.com/",
          "name": "Mitchell Haw",
          "publisher": {
            "@id": "https://mitchellhaw.com/#person"
          }
        }
      ]
    }
  </script>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">SEO & AI Search Consultant in Bend, Oregon</p>

          <h1>Can customers find your business?</h1>

          <p class="hero-text">
            Google. ChatGPT. Perplexity. Maps. YouTube. Local listings.
            I help businesses become visible wherever people search.
          </p>

          <div class="hero-buttons">
            <a href="/contact" class="primary-btn">Get a Visibility Review</a>
            <a href="/services/ai-search" class="secondary-btn">AI Search Strategy</a>
          </div>
        </div>

        <div class="visibility-card">
          <p class="card-label">Search Visibility Dashboard</p>

          <div class="dashboard-list">
            <div class="dashboard-row">
              <span>Google Search</span>
              <span class="status active">Visible</span>
            </div>

            <div class="dashboard-row">
              <span>AI Search</span>
              <span class="status active">Visible</span>
            </div>

            <div class="dashboard-row">
              <span>Google Maps</span>
              <span class="status active">Visible</span>
            </div>

            <div class="dashboard-row">
              <span>YouTube</span>
              <span class="status warning">Opportunity</span>
            </div>

            <div class="dashboard-row">
              <span>Local Listings</span>
              <span class="status active">Visible</span>
            </div>

            <div class="dashboard-row">
              <span>Reviews</span>
              <span class="status active">Visible</span>
            </div>

            <div class="dashboard-row">
              <span>Content Coverage</span>
              <span class="status warning">Opportunity</span>
            </div>
          </div>

          <div class="dashboard-summary">
            <div>
              <strong>7</strong>
              <span>Search Channels</span>
            </div>

            <div>
              <strong>Search Everywhere</strong>
              <span>Strategy</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="intro">
      <div class="container intro-grid">
        <div>
          <p class="section-label">Modern search strategy</p>
          <h2>SEO is no longer just rankings and keywords.</h2>
        </div>

        <div>
          <p>
            People now discover businesses through Google, maps, AI answers,
            YouTube, social platforms, local listings, reviews, and content recommendations.
          </p>

          <p>
            I help businesses connect those pieces into one practical search strategy
            that makes it easier to get found.
          </p>
        </div>
      </div>
    </section>

    <section class="scorecard">
      <div class="container scorecard-grid">
        <div>
          <p class="section-label">Free visibility check</p>
          <h2>How visible is your business across modern search?</h2>
          <p>
            I can review how your business shows up across Google, AI search,
            maps, YouTube, local listings, and content-driven discovery.
          </p>
          <a href="/contact" class="primary-btn">Request a Visibility Review</a>
        </div>

        <div class="scorecard-panel">
          <div class="score-row">
            <span>Google Search</span>
            <strong>SEO foundation</strong>
          </div>

          <div class="score-row">
            <span>AI Search</span>
            <strong>Answer visibility</strong>
          </div>

          <div class="score-row">
            <span>Google Maps</span>
            <strong>Local discovery</strong>
          </div>

          <div class="score-row">
            <span>YouTube</span>
            <strong>Video search</strong>
          </div>

          <div class="score-row">
            <span>Reviews & Listings</span>
            <strong>Trust signals</strong>
          </div>

          <div class="score-row">
            <span>Website Content</span>
            <strong>Search intent coverage</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="services">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">What I help with</p>
          <h2>Search visibility built for how people find businesses now.</h2>
        </div>

        <div class="service-grid">
          <div class="card">
            <span class="card-number">01</span>
            <h3>SEO Strategy</h3>
            <p>
              Technical SEO, keyword research, metadata, internal linking,
              site architecture, content planning, and organic growth strategy.
            </p>
          </div>

          <div class="card">
            <span class="card-number">02</span>
            <h3>AI Search Visibility</h3>
            <p>
              Improve visibility across ChatGPT, Perplexity, Gemini,
              AI Overviews, and answer engines.
            </p>
          </div>

          <div class="card">
            <span class="card-number">03</span>
            <h3>Local SEO</h3>
            <p>
              Google Business Profile optimization, maps visibility,
              reviews, citations, and local landing pages.
            </p>
          </div>

          <div class="card">
            <span class="card-number">04</span>
            <h3>Video & Content Discovery</h3>
            <p>
              Search-friendly YouTube strategy, short-form content,
              and video discovery across search and social platforms.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="search-everywhere">
      <div class="container search-grid">
        <div>
          <p class="section-label light">Search everywhere</p>
          <h2>Your customers are searching in more places than ever.</h2>
          <p>
            I help businesses show up in the places that matter most,
            from traditional organic results to AI-generated answers,
            local maps, video platforms, and content discovery.
          </p>
        </div>

        <div class="channel-grid">
          <div>Google Search</div>
          <div>Google Maps</div>
          <div>AI Answers</div>
          <div>YouTube</div>
          <div>Local Listings</div>
          <div>Content Hubs</div>
        </div>
      </div>
    </section>

    <section class="about">
      <div class="container about-grid">
        <div>
          <p class="section-label">About</p>
          <h2>Practical SEO and AI search support from Bend, Oregon.</h2>
        </div>

        <div>
          <p>
            I’m Mitchell Haw, a digital strategist focused on SEO, AI search,
            local visibility, content strategy, and organic growth.
          </p>

          <p>
            I work with businesses that want clear strategy, useful content,
            stronger technical foundations, and better visibility across the full search journey.
          </p>

          <p>
            Based in Bend, Oregon, I bring a practical, long-term approach shaped by both national brand experience and local business visibility work.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container narrow">
        <p class="section-label">Ready to improve visibility?</p>
        <h2>Let’s make your business easier to find.</h2>
        <p>
          Whether you need SEO strategy, AI search support, local SEO help,
          or a clearer content roadmap, I can help you figure out what to focus on next.
        </p>
        <a href="/contact" class="primary-btn">Contact Me</a>
      </div>
    </section>
  </main>
</Layout>
