---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mitchell Haw | SEO & AI Search Consultant in Bend, Oregon"
  description="Mitchell Haw helps businesses improve SEO, AI search visibility, local search, content strategy, and organic growth."
>
  <main>
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Bend, Oregon SEO & AI Search Consultant</p>

        <h1>SEO, AI search, and digital visibility for brands that want to be found.</h1>

        <p class="hero-text">
          I help businesses improve visibility across Google, AI search,
          local discovery, maps, and content-driven search experiences.
        </p>

        <div class="hero-buttons">
          <a href="/services/seo" class="primary-btn">SEO Services</a>
          <a href="/services/ai-search" class="secondary-btn">AI Search Help</a>
        </div>
      </div>
    </section>

    <section class="intro">
      <div class="container narrow">
        <p class="section-label">Practical search strategy</p>
        <h2>Clear SEO and AI search help with a Central Oregon mindset.</h2>
        <p>
          I focus on technical SEO, content strategy, local visibility,
          AI search readiness, and helping brands become easier to find online.
        </p>
      </div>
    </section>

    <section class="services">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">Services</p>
          <h2>What I help with</h2>
        </div>

        <div class="service-grid">
          <div class="card">
            <h3>SEO Strategy</h3>
            <p>Technical SEO, keyword research, metadata, internal linking, site architecture, and organic growth strategy.</p>
          </div>

          <div class="card">
            <h3>AI Search Visibility</h3>
            <p>Improve visibility across ChatGPT, Perplexity, Gemini, AI Overviews, and answer engines.</p>
          </div>

          <div class="card">
            <h3>Local SEO</h3>
            <p>Google Business Profile optimization, maps visibility, reviews, citations, and local landing pages.</p>
          </div>

          <div class="card">
            <h3>Video Marketing</h3>
            <p>Search-friendly YouTube strategy, short-form content, and video discovery across search and social platforms.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="about">
      <div class="container about-grid">
        <div>
          <p class="section-label light">About</p>
          <h2>Hi, I’m Mitchell Haw.</h2>
        </div>

        <div>
          <p>
            I work in SEO and organic search strategy, helping brands improve visibility
            across Google, AI search engines, local listings, and content platforms.
          </p>

          <p>
            Based in Bend, Oregon, I bring a practical, long-term approach focused on
            useful content, discoverability, and strong digital foundations.
          </p>
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="container narrow">
        <p class="section-label">Reach Out</p>
        <h2>Looking for help with SEO or AI search visibility?</h2>
        <p>
          Whether you need SEO strategy, AI search support, local SEO help, or content planning,
          feel free to reach out.
        </p>
        <a href="/contact" class="primary-btn">Contact Me</a>
      </div>
    </section>
  </main>
</Layout>
