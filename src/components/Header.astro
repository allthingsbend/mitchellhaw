---
// src/components/Header.astro
---
<header class="site-header">
  <div class="nav-container">
    <a href="/" class="logo">Mitchell Haw</a>
    <nav>
      <a href="/services/seo">SEO</a>
      <a href="/services/ai-search">AI Search</a>
      <a href="/services/video-marketing">Video Marketing</a>
      <a href="/about">About</a>
      <a href="/contact" class="nav-cta">Reach Out</a>
    </nav>
  </div>
</header>

<style is:global>
  /* The 'is:global' directive prevents Astro from adding those data IDs */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 999;
    background: rgba(246, 241, 232, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(35, 79, 66, 0.1);
  }

  .nav-container {
    width: min(1180px, 94%);
    margin: 0 auto;
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    font-size: 1.15rem;
    font-weight: 800;
    text-decoration: none;
    color: #102f29; /* pine-dark */
  }

  nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  nav a {
    text-decoration: none;
    font-weight: 700;
    color: #102f29;
  }

  .nav-cta {
    background: #234f42; /* pine */
    color: white !important;
    padding: 10px 18px;
    border-radius: 999px;
  }
</style>
