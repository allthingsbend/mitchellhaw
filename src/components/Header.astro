---
// src/components/Header.astro
---

<header class="site-header">
  <div class="nav-container">
    <a href="/" class="logo">Mitchell Haw</a>

    <nav class="main-nav">
      <a href="/services/seo">SEO</a>
      <a href="/services/ai-search">AI Search</a>
      <a href="/services/video-marketing">Video</a>
      <a href="/about">About</a>
      <a href="/contact" class="nav-cta">Reach Out</a>
    </nav>
  </div>
</header>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 999;
    background: rgba(246, 241, 232, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(35, 79, 66, 0.1);
  }

  .nav-container {
    width: min(1180px, 94%);
    margin: 0 auto;
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    font-size: 1.15rem;
    font-weight: 800;
    text-decoration: none;
    color: #102f29;
    white-space: nowrap;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .main-nav a {
    text-decoration: none;
    font-weight: 700;
    color: #102f29;
    white-space: nowrap;
  }

  .nav-cta {
    background: #234f42;
    color: white !important;
    padding: 10px 18px;
    border-radius: 999px;
  }

  @media (max-width: 700px) {
    .nav-container {
      min-height: auto;
      padding: 16px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .main-nav {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .main-nav a {
      font-size: 0.95rem;
      padding: 8px 10px;
      background: rgba(35, 79, 66, 0.08);
      border-radius: 999px;
    }

    .main-nav .nav-cta {
      padding: 8px 14px;
      background: #234f42;
    }
  }
</style>
