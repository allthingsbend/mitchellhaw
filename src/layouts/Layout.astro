---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/editorial.css';

const {
  title,
  description = "SEO, AI search, local SEO, content strategy, and digital visibility consulting from Mitchell Haw in Bend, Oregon.",
  image = "/images/smith-rock-central-oregon.jpg"
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = new URL(image, Astro.site ?? Astro.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mitchell Haw',
  url: 'https://mitchellhaw.com/',
  jobTitle: 'SEO and AI Search Consultant',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bend',
    addressRegion: 'OR',
    addressCountry: 'US'
  }
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/images/mh-favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-E7RJTWV4VN"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        window.dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('config', 'G-E7RJTWV4VN');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mitchell Haw" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  /* Central Oregon palette across the shared service design. */
  :root {
    --paper: #f6f4ee;
    --surface-soft: #edf2ed;
    --accent: #2f6f8f;
    --accent-hover: #275f7b;
    --accent-soft: #e9f2f5;
    --forest: #356b57;
    --forest-soft: #e6eee8;
  }

  /* Shared service-page cleanup: keep inner pages aligned with the site header. */
  .page-hero .container.narrow {
    width: min(1180px, 92%) !important;
    max-width: 1180px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: left !important;
  }

  .page-hero h1 {
    max-width: 860px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    font-size: clamp(3rem, 5vw, 5.1rem) !important;
    line-height: 1 !important;
  }

  .page-hero p:not(.section-label):not(.eyebrow) {
    max-width: 760px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    font-size: 1.04rem !important;
  }

  .page-hero .hero-buttons {
    justify-content: flex-start !important;
  }

  @media (max-width: 720px) {
    .page-hero h1 {
      font-size: clamp(2.75rem, 12vw, 4rem) !important;
    }
  }
</style>