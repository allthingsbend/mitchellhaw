---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title, description = "SEO, AI search, local SEO, content strategy, and digital visibility consulting from Mitchell Haw in Bend, Oregon." } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/images/mh-favicon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
